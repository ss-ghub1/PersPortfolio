# Database - generated locally by run_monthly_load.py, never committed
data/*.db
data/*.db-journal
# Backups written by fix_instrument_ids.py --apply (full copies of the database)
data/*.db.bak-*

# Raw statements you download (personal financial documents) - never committed
IN/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Generated output (Excel snapshots etc)
output/

# OS cruft
.DS_Store

# Endowus export script: the browser profile holds live login cookies; the workbooks hold your holdings
.endowus_browser/
endowus_block_log.txt
Endowus_*Export*.xlsx
